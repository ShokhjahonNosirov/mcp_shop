# Copy to .env and adjust. All settings are optional except the database URL.

# Connect as the SELECT-only role, never as the database owner.
SHOP_MCP_DATABASE_URL=postgresql://mcp_readonly:mcp_readonly_pw@127.0.0.1:55432/shop

# Limits applied to every query.
SHOP_MCP_MAX_ROWS=200
SHOP_MCP_STATEMENT_TIMEOUT_MS=5000

# Connection pool.
SHOP_MCP_POOL_MIN_SIZE=1
SHOP_MCP_POOL_MAX_SIZE=5

# stdio (the host launches the server) or streamable-http (long-running service).
SHOP_MCP_TRANSPORT=stdio
SHOP_MCP_HTTP_HOST=127.0.0.1
SHOP_MCP_HTTP_PORT=8000

SHOP_MCP_LOG_LEVEL=INFO

# --- shop-agent (the Claude tool-use client) --------------------------------

# Your Claude API key. Never commit it: .env is git-ignored.
ANTHROPIC_API_KEY=

# Model and how hard it thinks (low, medium, high, xhigh, max).
SHOP_AGENT_MODEL=claude-opus-5-5
SHOP_AGENT_EFFORT=medium

# Maximum model calls per question, before the run is stopped.
SHOP_AGENT_MAX_STEPS=10

# stdio starts the server as a subprocess (only the db container is needed);
# http connects to a running server, e.g. `docker compose up`.
SHOP_AGENT_TRANSPORT=stdio
SHOP_AGENT_MCP_URL=http://127.0.0.1:8000/mcp

# Structured run log, one JSON object per line. Empty disables it.
SHOP_AGENT_LOG_FILE=logs/agent.jsonl
