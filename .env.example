# Copy to .env and adjust. All settings are optional except the database URL.

# Connect as the SELECT-only role, never as the database owner.
SHOP_MCP_DATABASE_URL=postgresql://mcp_readonly:mcp_readonly_pw@127.0.0.1:55432/shop

# Limits applied to every query.
SHOP_MCP_MAX_ROWS=200
SHOP_MCP_STATEMENT_TIMEOUT_MS=5000

# Connection pool.
SHOP_MCP_POOL_MIN_SIZE=1
SHOP_MCP_POOL_MAX_SIZE=5

# stdio (the host launches the server) or streamable-http (long-running service).
SHOP_MCP_TRANSPORT=stdio
SHOP_MCP_HTTP_HOST=127.0.0.1
SHOP_MCP_HTTP_PORT=8000

SHOP_MCP_LOG_LEVEL=INFO
